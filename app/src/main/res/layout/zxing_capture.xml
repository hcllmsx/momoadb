<?xml version="1.0" encoding="utf-8"?>
<!--
    覆盖 zxing-android-embedded 的同名布局（app 资源优先于库资源）：
    给取景框设定固定尺寸（240dp 方形），提示文本的位置因此可精确计算——
    框底距中心恒为 120dp，配套的 zxing_barcode_scanner.xml 把提示放在框外下方。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!--
    This Activity is typically full-screen. Therefore we can safely use centerCrop scaling with
    a SurfaceView, without fear of weird artifacts. -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/zxing_barcode_scanner"
        app:zxing_preview_scaling_strategy="centerCrop"
        app:zxing_use_texture_view="false"
        app:zxing_framing_rect_width="240dp"
        app:zxing_framing_rect_height="240dp" />

</merge>
